{
  "name": "@touchgrass/node",
  "version": "0.1.0",
  "description": "Fail-open error SDK for touchgrass: uncaught exceptions, manual reports, breadcrumbs, release tags.",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": ["dist", "dist-cjs", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/oralecarlangelo/touchgrass.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/oralecarlangelo/touchgrass/tree/develop/sdk/node",
  "bugs": "https://github.com/oralecarlangelo/touchgrass/issues",
  "keywords": ["touchgrass", "error-tracking", "sentry-alternative", "monitoring", "self-hosted"],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && printf '{\"type\":\"commonjs\"}' > dist-cjs/package.json",
    "test": "vitest run",
    "verify": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.cjs.json && eslint . && vitest run",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
